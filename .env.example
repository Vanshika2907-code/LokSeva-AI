# Gemini API Key - Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase browser client. The anon key is safe to expose to the browser, but
# never use a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Local SMTP (Gmail): use a Google App Password, not your account password.
# Gmail uses STARTTLS on port 587 by default. Do not use this provider on a
# Render free service, because Render blocks outbound SMTP ports.
EMAIL_PROVIDER=smtp
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
EMAIL_FROM="LokSeva Portal <your_email@gmail.com>"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_CONNECTION_TIMEOUT_MS=15000

# Render production OTP delivery (HTTPS). Create a Resend API key and verify
# the domain used by EMAIL_FROM. Set EMAIL_PROVIDER=resend on Render.
# RESEND_API_KEY=re_your_resend_api_key_here
